# ==============================================================================
# DataFlow Engineering Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NOTE: Never commit sensitive credentials to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Database Settings
# Default: SQLite local database
DATABASE_URL=sqlite:///database/dataflow.db
# Optional PostgreSQL (uncomment to use):
# DATABASE_URL=postgresql://user:password@localhost:5432/dataflow_db

# Pipeline Settings
ETL_TIMEZONE=UTC
ETL_BATCH_SIZE=50
ETL_MAX_RETRIES=3
ETL_RETRY_BACKOFF_FACTOR=1.5

# Notification Settings (Optional)
# Supported channels: console, webhook, smtp
ALERT_CHANNELS=console
WEBHOOK_URL=https://hooks.example.com/services/mock/webhook

# SMTP Email Configuration (Optional - Console fallback active by default)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=mock_username
SMTP_PASSWORD=mock_password
SMTP_FROM=alerts@dataflow.studio
SMTP_TO=devops@dataflow.studio
SMTP_USE_TLS=true
